MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Base64 编码的 32 字节 HMAC 密钥，生产环境必须重新生成。
JWT_SECRET=ZGV2LWp3dC1zaWduaW5nLXNlY3JldC1rZXktMDAwMDE=
# Base64 编码的 32 字节 AES 密钥，生产环境必须重新生成。
CREDENTIAL_MASTER_KEY=ZGV2LWNyZWRlbnRpYWwtbWFzdGVyLWtleS0wMDAwMDE=
# 仅用于本地 Compose 开发，生产环境必须替换为独立强密码。
ADMIN_INITIAL_PASSWORD=dev_admin_2026

# 订阅邮件为可选配置；留空时订阅可保存，但执行发送会失败并记录明确错误。
